# Port the server listens on. Render sets this automatically — no action needed there.
PORT=3000

# Comma-separated list of allowed origins for CORS.
# Leave unset to allow any origin (fine for local dev / this assessment).
# In production, set this to your deployed Vercel URL, e.g.:
# CORS_ORIGIN=https://card-validator.vercel.app
CORS_ORIGIN=
